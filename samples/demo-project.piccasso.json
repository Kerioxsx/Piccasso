  "steps": [
    {
      "id": "step-1-page",
      "kind": "page",
      "title": "Prepare the page",
      "instruction": "Place your paper in landscape orientation. Leave a border of about 1.5 cm. Your drawing will fill an area about 24.0 cm wide and 18.0 cm tall. Lightly mark the top, bottom, left and right edges of that area with tiny dots.",
      "tip": "Press very lightly. These marks are only guides and will be erased later.",
      "checks": [
        "Are the four edge marks about 24.0 cm apart side to side and 18.0 cm top to bottom?",
        "Is there an even border all around?"
      ],
      "motion": "Hold the pencil loosely, far from the tip. Make small dots; don't drag the pencil.",
      "base": "none",
      "layers": [
        "frame",
        "subjectBox",
        "grid"
      ],
      "terms": [
        "proportion"
      ]
    },
    {
      "id": "step-2-shapes",
      "kind": "shapes",
      "title": "Block in basic shapes",
      "instruction": "Look for simple shapes inside the picture. Start with a large oval near the middle, a large box near the right side and a medium oval near the middle. Draw each one as a loose, light outline. Don't worry about details yet.",
      "tip": "Hold the pencil further from the tip and draw from your shoulder for smoother ovals.",
      "checks": [
        "Do you have a large oval near the middle, a large box near the right side and a medium oval near the middle?",
        "Are your lines light enough to erase?"
      ],
      "motion": "Draw from your shoulder with your whole arm. Go around each oval 2-3 times very lightly, then keep the best line.",
      "base": "light",
      "layers": [
        "frame",
        "subjectBox",
        "shapes"
      ],
      "terms": [
        "construction"
      ]
    },
    {
      "id": "step-3-proportions",
      "kind": "proportions",
      "title": "Check proportions",
      "instruction": "The whole subject is about 1.8 times as wide as it is tall. Compare your shapes: the large oval is about the same size as the large box. Fix any shape that looks too big, too small or out of place before moving on.",
      "tip": "Hold your pencil at arm's length and use it like a ruler to compare sizes.",
      "checks": [
        "Is the whole drawing about 1.8 times as wide as it is tall?",
        "Squint at your paper and the guide. Do the big shapes match?"
      ],
      "motion": "Keep your arm straight and close one eye when you measure with the pencil, so every measurement is taken the same way.",
      "base": "light",
      "layers": [
        "frame",
        "subjectBox",
        "shapes",
        "measures"
      ],
      "terms": [
        "proportion",
        "negative_space"
      ]
    },
    {
      "id": "step-4-contours",
      "kind": "contours",
      "title": "Draw the main outline",
      "instruction": "Now follow the outside edge of the subject (its silhouette). Begin at the top and travel around the shape. The outline has 7 noticeable turns. Use your basic shapes as a frame.",
      "tip": "Use several short strokes instead of one long line; it's easier to stay on track.",
      "checks": [
        "Does your outline start near the top?",
        "Does the outline stay close to your basic shapes?"
      ],
      "motion": "Move from the elbow in short, overlapping strokes. Turn the paper so curves are always comfortable to draw.",
      "base": "light",
      "layers": [
        "shapes",
        "silhouette"
      ],
      "terms": [
        "contour",
        "silhouette"
      ]
    },
    {
      "id": "step-5-features",
      "kind": "features",
      "title": "Refine features",
      "instruction": "Add the smaller edges and features. Most of the detail is near the top left. Work from the largest features to the smallest, checking each one against the guide.",
      "tip": "Turn the paper as you draw so your hand moves in a comfortable direction.",
      "checks": [
        "Is most of your detail near the top left, like in the guide?",
        "Did you work from big features to small ones?"
      ],
      "motion": "Rest the side of your hand on a scrap of paper (so you don't smudge) and use small finger movements for details.",
      "base": "outline",
      "layers": [
        "silhouette",
        "internal",
        "landmarks"
      ],
      "terms": [
        "contour",
        "perspective"
      ]
    },
    {
      "id": "step-6-clean",
      "kind": "clean",
      "title": "Clean up the sketch",
      "instruction": "Gently erase the construction shapes and the page marks you no longer need. Then go over the lines you want to keep with a slightly firmer stroke.",
      "tip": "A kneaded eraser lifts graphite without damaging the paper.",
      "checks": [
        "Are the construction lines gone or very faint?",
        "Are the important outlines a little darker now?"
      ],
      "motion": "Dab or roll the eraser instead of rubbing hard; rubbing damages the paper.",
      "base": "outline",
      "layers": [
        "silhouette",
        "internal"
      ],
      "terms": [
        "construction"
      ]
    },
    {
      "id": "step-7-pressure",
      "kind": "pressure",
      "title": "Pencil pressure and grades",
      "instruction": "Before shading, learn how hard to press. This picture needs 3 tones: light (15% pressure, HB pencil, mostly near the top left), medium (45% pressure, 2B pencil, mostly near the middle) and firm (75% pressure, 4B pencil, mostly near the middle). Practise each tone in a small square at the edge of your paper first. Leave the shiny highlights as untouched white paper.",
      "tip": "Pressure is easier to control than you think: try counting 1-2-3 for light, medium and firm before you start.",
      "checks": [
        "Can you make each tone in your practice squares?",
        "Is your lightest tone barely visible?"
      ],
      "motion": "Hold the pencil at a low angle and use the side of the lead. Stroke back and forth in one direction without lifting.",
      "base": "values",
      "layers": [
        "pressure"
      ],
      "terms": [
        "pressure",
        "grades",
        "value"
      ]
    },
    {
      "id": "step-8-values",
      "kind": "values",
      "title": "Shadows and values",
      "instruction": "The light seems to come from the top left, so the shadows fall on the opposite side. The darkest areas are near the middle. Shade with small back-and-forth strokes going the same direction; overlap them so no gaps show. Shade the dark shapes first, then the middle tones. Leave the brightest areas as clean paper.",
      "tip": "Build darkness slowly with light layers instead of pressing hard.",
      "checks": [
        "Are your darkest areas near the middle?",
        "Did you leave the brightest spots as clean paper?"
      ],
      "motion": "Keep a low pencil angle and follow the curve of each surface with your strokes. Change pressure, not speed.",
      "base": "values",
      "layers": [
        "silhouette",
        "light"
      ],
      "terms": [
        "value",
        "shading",
        "highlight",
        "blending"
      ]
    }
